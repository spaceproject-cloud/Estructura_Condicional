Algoritmo sin_titulo
	Definir letra Como Caracter
	Escribir "Ingrese la letra"
	Leer letra
	si letra == "a" o letra == "A" Entonces
		Imprimir "Android"
	SiNo
		Si letra == "i" o letra == "I" Entonces
			Imprimir "iOS"
		SiNo
			Imprimir "Opcion invalida"
		FinSi
	FinSi
FinAlgoritmo









